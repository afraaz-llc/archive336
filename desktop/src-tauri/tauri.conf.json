{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARCHIVE336",
  "version": "0.1.2",
  "identifier": "com.archive336.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARCHIVE336",
        "width": 520,
        "height": 520,
        "resizable": true,
        "minWidth": 440,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aether-archive-tool",
          "archive336"
        ]
      }
    }
  }
}