[Unit]
Description=ARCHIVE336 — run Stripe state reconciliation daily

[Timer]
# 03:00 UTC — 30 min after the R2 storage reconciliation, so they
# don't pile up at the same minute. Persistent=true means a missed
# run (e.g. server was down) fires on next boot.
OnCalendar=*-*-* 03:00:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
