[Unit]
Description=ARCHIVE336 — run storage reconciliation daily

[Timer]
# 02:30 UTC every day — after the meter at 02:00 so reconciliation
# doesn't race the snapshot. Persistent=true means a missed run
# (e.g. server was down) fires on next boot.
OnCalendar=*-*-* 02:30:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
