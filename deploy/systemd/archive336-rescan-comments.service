[Unit]
Description=ARCHIVE336 — daily comments rescan
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aether/app/backend
EnvironmentFile=/opt/aether/.env
ExecStart=/opt/aether/venv/bin/python -m scripts.rescan_comments
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aether
