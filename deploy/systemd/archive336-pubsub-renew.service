[Unit]
Description=ARCHIVE336 — PubSubHubbub subscription renewal
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aether/app/backend
EnvironmentFile=/opt/aether/.env
ExecStart=/opt/aether/venv/bin/python -m scripts.renew_pubsub_subscriptions
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aether
