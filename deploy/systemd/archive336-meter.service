[Unit]
Description=ARCHIVE336 — daily storage metering
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/aether/app/backend
EnvironmentFile=/opt/aether/.env
ExecStart=/opt/aether/venv/bin/python -m scripts.meter
# Hardening to match archive336-api.service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aether
