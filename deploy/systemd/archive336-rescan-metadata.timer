[Unit]
Description=ARCHIVE336 — daily metadata rescan

[Timer]
# 03:30 UTC every day. Offset from archive336-meter (02:00) so the two cron
# jobs don't fight for the DB lock. Persistent=true so a missed run
# (server reboot, maintenance) fires on next boot.
OnCalendar=*-*-* 03:30:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
